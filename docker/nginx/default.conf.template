server {
    
    listen 80;

    root /var/www;
    index index.html;

    location /users {
        proxy_pass http://nodecommand-container:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        autoindex on;
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;

}
